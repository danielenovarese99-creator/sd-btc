# Parametri strategia (default = quelli richiesti)
EMA_FAST=9
EMA_SLOW=18
Z_LEN=20
TP_Z=2.0
TP_FRACTION=0.5

# Email (come per gli altri sistemi)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
