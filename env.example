HL_ACCOUNT_ADDRESS=0x...
HL_AGENT_PRIVATE_KEY=0x...
HL_ENV=mainnet

# Sub-account DEDICATO (obbligatorio se usi anche la strategia BTC 1349: su Hyperliquid c'e' una sola posizione BTC per account)
HL_VAULT_ADDRESS=

DRY_RUN=true

STRAT_CAPITAL_USD=300
LEVERAGE_FACTOR=1.0
